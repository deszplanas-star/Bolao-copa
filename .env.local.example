# ============================================================
# Bolão 26 — Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env.local e preencha com os valores reais.
# .env.local NUNCA é commitado (está no .gitignore).
#
# Onde achar cada valor:
#   Supabase Dashboard → Project Settings → API Keys
# ============================================================

# Project URL (público, vai no client-side)
NEXT_PUBLIC_SUPABASE_URL=https://tsecywhgikstgyrgmnos.supabase.co

# Anon / Publishable key (público, RLS protege o banco)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJI...COLE_SUA_ANON_KEY_AQUI

# Service Role / Secret key (PRIVADO — server-side apenas)
# Bypassa RLS — use APENAS em server actions, route handlers ou edge functions.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...COLE_SUA_SECRET_KEY_AQUI

# Admin emails (separados por vírgula) — quem pode acessar /admin
ADMIN_EMAILS=davidson.planas@empresta.com.br

# Pix info (apenas exibida no modal — não processa nada)
NEXT_PUBLIC_PIX_KEY=davidson@empresta.com.br
NEXT_PUBLIC_PIX_AMOUNT=50

# E-mail transacional (Resend) — opcional na fase 0
RESEND_API_KEY=
RESEND_FROM_EMAIL=bolao@empresta.com.br
